# Copy this file to src-tauri/.env (git-ignored) and fill in the values.

# Google Gemini API key for AI Study chat. Get one at https://aistudio.google.com/apikey
# Leave empty to keep placeholder replies.
GEMINI_API_KEY=

# Optional: model and per-student daily message limit.
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_DAILY_MESSAGE_LIMIT=50

# Quizlab: AI quizzes per student per day, and questions per AI quiz (max 50).
# AI_DAILY_QUIZ_LIMIT=5
# AI_MAX_QUIZ_QUESTIONS=30

# AI reviews of finished quizzes per student per day (cached; retakes get a new one).
# AI_DAILY_FEEDBACK_LIMIT=10
