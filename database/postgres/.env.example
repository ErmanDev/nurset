# Copy to database/postgres/.env (git-ignored) and adjust.

# Local Docker database (pnpm db:up)
DATABASE_URL=postgres://nurset:nurset_dev@localhost:5433/nurset

# Render: paste the database's *External Database URL* to migrate from your
# computer. Services running on Render should use the *Internal* URL instead.
# DATABASE_URL=postgres://USER:PASSWORD@HOST.render.com/DBNAME

# Only if TLS certificate verification fails for a trusted host:
# DB_SSL_NO_VERIFY=1
