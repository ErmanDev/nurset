# Copy to server/.env (git-ignored) for local runs. On Render, set these as
# environment variables on the web service instead.

# PostgreSQL. Local Docker default shown; on Render use the Internal Database URL.
DATABASE_URL=postgres://nurset:nurset_dev@localhost:5433/nurset

# Where uploaded documents and materials are stored (Render: the disk mount path).
UPLOAD_DIR=uploads

# Time zone for "today", deadlines, and daily AI limits.
TZ=Asia/Manila

# Google Gemini API key for AI Study (https://aistudio.google.com/apikey).
# Leave empty to run without AI (chat placeholder, built-in quizzes, basic feedback).
GEMINI_API_KEY=

# Optional AI settings.
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_DAILY_MESSAGE_LIMIT=50
# AI_DAILY_QUIZ_LIMIT=5
# AI_MAX_QUIZ_QUESTIONS=30
# AI_DAILY_FEEDBACK_LIMIT=10

# PORT is set by Render; locally the server listens on 8080.
