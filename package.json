{
  "name": "nurset",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "pnpm db:up && pnpm db:migrate && tauri dev",
    "app:build": "tauri build",
    "db:up": "docker compose -f database/postgres/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f database/postgres/docker-compose.yml down",
    "db:migrate": "node --env-file-if-exists=database/postgres/.env database/postgres/scripts/migrate.mjs",
    "db:create-instructor": "node --env-file-if-exists=database/postgres/.env database/postgres/scripts/create-instructor.mjs",
    "db:status": "node --env-file-if-exists=database/postgres/.env database/postgres/scripts/migrate.mjs --status"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
